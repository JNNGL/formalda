# HTTP
APP_PORT=8080
FORMALDA_BASE_URL=http://localhost:8080

# MariaDB
DB_PORT=3306
DB_NAME=formalda
DB_USER=formalda
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password

# Development SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
FORMALDA_MAIL_FROM=noreply@formalda.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# The first administrator is created only when the database has no administrator.
FORMALDA_ADMIN_EMAIL=admin@example.local
FORMALDA_ADMIN_USERNAME=admin
FORMALDA_ADMIN_PASSWORD=change-this-admin-password
